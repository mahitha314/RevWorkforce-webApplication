<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

	<Appenders>

		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n" />
		</Console>
		!-- Rolling File Logger --> <RollingFile name="FileLogger"
			fileName="logs/revworkforce.log"
			filePattern="logs/revworkforce-%d{yyyy-MM-dd}.log">

			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n" />

			<Policies>
				<TimeBasedTriggeringPolicy interval="1" />
			</Policies>

		</RollingFile>

	</Appenders>

	<Loggers>

		<Logger name="com.revworkforce" level="debug" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="FileLogger" />
		</Logger>

		<Root level="info">
			<AppenderRef ref="Console" />
			<AppenderRef ref="FileLogger" />
		</Root>

	</Loggers>

</Configuration>